# TikTok Scraper Configuration
# Cookie de sesión opcional para saltar login walls y desbloquear listas privadas
# Obtén tu sessionid desde DevTools -> Application -> Cookies -> https://www.tiktok.com
TIKTOK_SESSION_ID=tu_cookie_sessionid_aqui

# Google Gemini API Key para enriquecimiento de datos y análisis psicométrico Big Five (OCEAN)
# Consíguela gratis en https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Sincronización automática opcional con Figma
# Genera tu token en Figma: Settings -> Security -> Personal Access Tokens
FIGMA_ACCESS_TOKEN=tu_figma_personal_access_token_aqui
FIGMA_FILE_KEY=tu_figma_file_key_aqui

